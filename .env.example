# Copy to .env (never committed) and fill in. Only needed for escalation.channel: telegram.
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token.
# 2. Each contact opens a chat with the bot and sends /start.
# 3. Get each chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates -> "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_PRIMARY=
TELEGRAM_CHAT_ID_SECONDARY=
